RewriteEngine On

# Bloquear acceso directo a logs y archivos sensibles.
<FilesMatch "\.(log|env)$">
    Require all denied
</FilesMatch>

# Si intentan entrar a la raíz del proyecto, mandarlos a public
RewriteRule ^$ public/ [L]

# Si la petición no es un archivo real, mandarlo todo al index de public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]