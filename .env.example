DB_HOST=localhost
DB_DATABASE=sistema_db_dev
DB_USERNAME=root
DB_PASSWORD=

JWT_KEY=cambiar_por_una_clave_aleatoria_larga
JWT_EXP=3600

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_STORAGE_PATH=

# IPs o redes de proxies confiables, separadas por coma.
# Vacío en desarrollo/local.
TRUSTED_PROXIES=

# Correo
# Desarrollo: MAIL_HOST vacío usa Mailpit local (127.0.0.1:1025, sin cifrado).
# Producción: configurar el relay SMTP real con TLS y credenciales.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@alquiler.local
MAIL_FROM_NAME=AlquilER
MAIL_ENCRYPTION=tls
MAIL_TO=contacto@alquiler.com.ar
FRONTEND_URL=http://localhost:3000

# Métricas locales de rendimiento; solo se activan con APP_ENV=development.
PERFORMANCE_METRICS_ENABLED=false
PERFORMANCE_METRICS_SLOW_SQL_MS=100