# No subir configuraciones locales de XAMPP o IDEs
.vs/
.idea/
.vscode/

vendor/
node_modules/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Logs
*.log

# Archivos subidos por los usuarios
/public/uploads/

